DATABASE_URL=postgresql://postgres.mrzyfpwnkdeptwmxoqnw:["YOUR PASSWORD"]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# LLM provider — powers the actual answers
GROQ_API_KEY=YOUR GROQ API KEY

# Web search — used by the agent for live/current-info queries (e.g. "what's the stock price today")
TAVILY_API_KEY=YOUR TAVILY API KEY

# Embedding model — must produce 384-dim vectors to match the pgvector column in the migration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Groq model name — which LLM on Groq to call
GROQ_MODEL=llama-3.3-70b-versatile